NODE_ENV=development
PORT=3001
COLLAB_PORT=1234
DATABASE_URL=postgresql://canvaslab:canvaslab-local-dev@localhost:5432/canvaslab
# For hosted PostgreSQL, replace DATABASE_URL with your provider's connection string.
SESSION_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173

APP_BASE_URL=http://localhost:5173
# Optional for local development: the UI shows a one-time reset URL without email delivery.
# For email delivery, configure both variables below. The webhook accepts JSON fields to, subject, text, and html.
PASSWORD_RESET_EMAIL_WEBHOOK_URL=
PASSWORD_RESET_EMAIL_WEBHOOK_SECRET=
